# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPEN_AI_API_KEY=
GOOGLE_API_KEY=

# Tried in order; a failing model passes the ticket to the next one.
PROVIDER_ORDER=claude,openai,google
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
GOOGLE_MODEL=gemini-2.5-pro
CORS_ORIGINS=http://localhost:5173
