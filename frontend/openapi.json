{
  "openapi": "3.1.0",
  "info": {
    "title": "Triage Agent API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/triage": {
      "post": {
        "tags": [
          "triage"
        ],
        "summary": "Triage",
        "description": "Route the ticket, then let the models decide, trying each in turn.",
        "operationId": "triage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "reply",
          "escalate"
        ],
        "title": "Action"
      },
      "Decision": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning",
            "description": "Why this action was chosen"
          },
          "reply_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply Text",
            "description": "Reply to the customer, when replying"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reasoning"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          }
        },
        "type": "object",
        "required": [
          "status",
          "agent"
        ],
        "title": "Health"
      },
      "TicketIn": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body"
          },
          "customer_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Email"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "body"
        ],
        "title": "TicketIn"
      },
      "TriageResult": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "route": {
            "type": "string",
            "title": "Route",
            "description": "agent or human, from the routing rules"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Model that decided, or rules / none"
          },
          "failed_attempts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Failed Attempts",
            "description": "Models that failed before this one"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "route",
          "provider",
          "failed_attempts",
          "ticket_id"
        ],
        "title": "TriageResult",
        "description": "A decision plus how it was reached: which model answered, and what failed first."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
