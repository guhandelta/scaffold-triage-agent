        ],
        "summary": "Resolve",
        "operationId": "resolve",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket Id"
            }
          },
          {
            "name": "x-user-name",
            "in": "header",
