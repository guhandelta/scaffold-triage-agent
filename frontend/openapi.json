    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Which agents are active, in fallback order, and how many doc sections they can read.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "reply",
          "escalate"
        ],
        "title": "Action"
      },
      "AssignIn": {
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Owner",
            "description": "Name of the person handling it"
          }
        },
        "type": "object",
        "required": [
          "owner"
        ],
        "title": "AssignIn"
      },
      "Body_upload_tickets": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": ".csv, .md, .txt or .docx"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_tickets"
      },
      "Decision": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning",
            "description": "Why this action was chosen"
          },
          "reply_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply Text",
            "description": "Reply to the customer, when replying"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations",
            "description": "Ids of the sources used"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reasoning"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "docs": {
            "type": "integer",
            "title": "Docs",
            "description": "Doc sections the agent can read"
          }
        },
        "type": "object",
        "required": [
          "status",
          "agent",
          "docs"
        ],
        "title": "Health"
      },
      "HistoryEvent": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "received, routed, retrieved, error, decided, grounding, ..."
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "description": "agent, rules, or the reviewer's name"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "detail",
          "actor"
        ],
        "title": "HistoryEvent"
      },
      "Note": {
        "properties": {
          "author": {
            "type": "string",
            "title": "Author"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "author",
          "text"
        ],
        "title": "Note"
      },
      "NoteIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "NoteIn"
      },
      "OverrideIn": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "reply_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply Text"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "OverrideIn"
      },
      "Permission": {
        "type": "string",
        "enum": [
          "assign",
          "note",
          "confirm",
          "override",
          "resolve"
        ],
        "title": "Permission"
      },
      "Role": {
        "type": "string",
        "enum": [
          "viewer",
          "agent",
          "reviewer",
          "admin"
        ],
        "title": "Role"
      },
      "Source": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable id: area/doc#section"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "human_only": {
            "type": "boolean",
            "title": "Human Only",
            "description": "The docs say a person must handle this"
          },
          "policy": {
            "type": "boolean",
            "title": "Policy",
            "description": "Guidance for the agent, never sent to customers"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "area",
          "title",
          "heading",
          "text",
          "human_only",
          "policy",
          "score"
        ],
        "title": "Source",
        "description": "One section of the support docs, as retrieved for a ticket."
      },
      "TicketIn": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body"
          },
          "customer_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Email"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "body"
        ],
        "title": "TicketIn"
      },
      "TicketRecord": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "ticket": {
            "$ref": "#/components/schemas/TicketIn"
          },
          "result": {
            "$ref": "#/components/schemas/TriageResult"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ],
            "description": "A reviewer's replacement decision"
          },
          "confirmed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed By"
          },
          "notes": {
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "type": "array",
            "title": "Notes"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEvent"
            },
            "type": "array",
            "title": "History"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "The decision in force: a reviewer's override, or else the agent's.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "ticket",
          "result",
          "status",
          "decision"
        ],
        "title": "TicketRecord",
        "description": "A triaged ticket: the agent's decision, reviewer changes, and everything that happened."
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "replied",
          "escalated",
          "resolved"
        ],
        "title": "TicketStatus"
      },
      "TriageResult": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "route": {
            "type": "string",
            "title": "Route",
            "description": "agent or human, from the routing rules"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Model that decided, or rules / none"
          },
          "failed_attempts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Failed Attempts",
            "description": "Models that failed before this one"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "sources": {
