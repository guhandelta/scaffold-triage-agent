            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tickets/{ticket_id}/notes": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Add Note",
        "operationId": "add_note",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
